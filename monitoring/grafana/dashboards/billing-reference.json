          "legendFormat": "{{service}}",
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{job=\"invoice-payments\",service=\"billing-service\",uri=~\"/api/v1/billing.*\"}[5m])))"
        }
