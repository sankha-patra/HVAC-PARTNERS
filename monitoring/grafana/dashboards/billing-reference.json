      "targets": [
        {
          "legendFormat": "{{service}}",
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"invoice-payments\",service=\"billing-service\",uri=~\"/api/v1/billing.*\"}[5m]))"
