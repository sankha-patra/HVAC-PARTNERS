  "panels": [
    {
      "options": {
        "mode": "markdown",
        "content": "Capture, invoice allocation, ERP posting, and bank settlement are separate records. PROCESSING/REQUIRES_ACTION can be normal for ACH. The API latency graph measures HTTP responses, not time until a bank payment settles. Missing data is not zero. Example alert thresholds are local settings, not production SLOs. These aggregate metrics contain no payment or customer identifiers."
      },
      "title": "US B2B collections â€” local reference",
      "gridPos": {
        "h": 4,
        "x": 0,
        "w": 24,
        "y": 0
      },
      "id": 99,
      "type": "text"
    },
    {
      "title": "Payments awaiting an outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "x": 0,
        "w": 8,
        "y": 4.0
      },
      "targets": [
        {
          "legendFormat": "{{service}}",
          "refId": "A",
          "expr": "billing_payments_unresolved"
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "invoice-payments-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
